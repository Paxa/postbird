{
  "name": "postbird",
  "main": "electrobun/main.ts",
  "version": "0.8.4",
  "repository": "https://github.com/Paxa/postbird",
  "license": "MIT",
  "description": "Postbird is a cross-platform PostgreSQL GUI client, written in TypeScript, powered by Electrobun",
  "scripts": {
    "sass": "sass assets/styles/style.scss public/style.css --watch",
    "test": "bun test tests/",
    "test:unit": "bun test tests/",
    "test:ui": "bun electrobun/bundle.ts && bunx electrobun build && POSTBIRD_TEST_UI=true bunx electrobun run",
    "integration_test": "bun run test:ui",
    "start": "bun electrobun/bundle.ts && bunx electrobun build && bunx electrobun run",
    "build": "bun electrobun/bundle.ts && bunx electrobun build",
    "dist": "bun electrobun/bundle.ts && bunx electrobun build --env=stable",
    "bundle": "bun electrobun/bundle.ts",
    "compile:views": "bun scripts/compile_views.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "author": {
    "name": "Pavel Evstigneev",
    "email": "pavel.evst@gmail.com",
    "url": "https://github.com/Paxa"
  },
  "devDependencies": {
    "@types/alertify": "^0.3.30",
    "@types/bun": "latest",
    "@types/jquery": "^3.5.3",
    "@types/mocha": "^10.0.10",
    "@types/mousetrap": "^1.6.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^7.14.5",
    "@types/semver": "~7.3.8",
    "electrobun": "^2.0.4",
    "eslint": "^7.32.0",
    "localStorage": "^1.0.4",
    "sass": "^1.49.9",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "connection-string": "4.3.4",
    "cross-env": "^7.0.3",
    "csv-stringify": "^5.6.5",
    "eventemitter2": "6.4.5",
    "moment": "^2.29.1",
    "node-ssh-forward": "https://github.com/Paxa/node-ssh-forward.git#add-timeout",
    "pg": "8.16.3",
    "pg-escape": "^0.2.0",
    "pug": "3.0.2",
    "semver": "^7.3.5",
    "slash": "^3.0.0",
    "sprintf-js": "1.1.2",
    "ssh-config": "^4.1.0",
    "strftime": "0.10.0"
  }
}
