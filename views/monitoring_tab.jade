mixin refreshIcon(size)
  svg.icon-refresh-svg(viewBox="0 0 16 16", width=size, height=size, fill="currentColor", aria-hidden="true")
    path(fill-rule="evenodd", d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z")
    path(d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z")

.monitoring-view
  .monitor-toolbar
    .toolbar-left
      span.monitor-subtitle Real-time performance & server diagnostics
    .toolbar-right
      button.btn-native.btn-toggle-live(class=isLive ? 'active' : '', title=isLive ? "Pause Live Monitoring" : "Resume Live Monitoring")
        span.live-pulse-dot
        span.live-status-text= isLive ? "Live Monitoring (3s)" : "Monitoring Paused"
      button.btn-native.btn-global-refresh(title="Refresh All Sections")
        +refreshIcon(12)
        span.btn-text Refresh All

  .monitor-sections-container
    // -------------------------------------------------------------
    // SECTION 1: OVERVIEW & REAL-TIME ACTIVITY
    // -------------------------------------------------------------
    .monitor-section(data-section="overview", class=expandedSections.overview ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Server Overview & Real-Time Activity
        span.section-badge.badge-realtime Real-time (3s)
        span.section-summary-text= sectionSummaries.overview || "Loading real-time overview..."
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Overview")
            +refreshIcon(11)

      .monitor-section-body
        .metric-cards-grid
          .metric-card
            .metric-title Total Connections
            .metric-value.metric-conns-val - / -
            .metric-progress-track
              .metric-progress-bar.metric-conns-bar(style="width: 0%")
            .metric-subtitle.metric-conns-sub Loading connections...
          
          .metric-card
            .metric-title Buffer Cache Hit Ratio
            .metric-value.metric-cache-val - %
            .metric-subtitle.metric-cache-sub Analyzing buffer hit rate...
          
          .metric-card
            .metric-title Throughput
            .metric-value.metric-qps-val 0 tx/s
            .metric-subtitle.metric-qps-sub Transactions commit/rollback
          
          .metric-card
            .metric-title Active Query Load
            .metric-value.metric-load-val 0 ms
            .metric-subtitle.metric-load-sub Cumulative active duration

        .charts-grid
          .chart-box
            .chart-header
              span.chart-title Throughput (Transactions / Second)
            .chart-container.chart-container-qps!= qpsChartSvg

          .chart-box
            .chart-header
              span.chart-title Summed Active Query Latency (ms)
            .chart-container.chart-container-latency!= latencyChartSvg

    // -------------------------------------------------------------
    // SECTION 2: ACTIVE & WAITING QUERIES
    // -------------------------------------------------------------
    .monitor-section(data-section="queries", class=expandedSections.queries ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Active & Waiting Queries
        span.section-summary-text= sectionSummaries.queries || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Active Queries")
            +refreshIcon(11)

      .monitor-section-body
        .lock-conflicts-banner(style="display: none;")
        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.active-queries-table
              thead
                tr
                  th(style="width: 70px;") PID
                  th(style="width: 90px;") User
                  th(style="width: 140px;") Client Name
                  th(style="width: 130px;") Client IP
                  th(style="width: 80px;") State
                  th(style="width: 110px;") Wait Event
                  th(style="width: 85px;") Duration
                  th Query
                  th(style="width: 150px;") Actions
              tbody
                tr
                  td(colspan="9", class="text-muted text-center", style="padding: 16px;") No active queries loaded.

    // -------------------------------------------------------------
    // SECTION 2: STORAGE & INDEX MEMORY FIT
    // -------------------------------------------------------------
    .monitor-section(data-section="storage", class=expandedSections.storage ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Storage & Memory Buffer Fit
        span.section-summary-text= sectionSummaries.storage || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Storage Stats")
            +refreshIcon(11)

      .monitor-section-body
        .storage-buffer-gauge-card
          .gauge-header
            .gauge-header-info
              .gauge-main-title Index Memory Cache Fit
              .gauge-sub-title Active index footprint vs shared_buffers (L1) and OS page cache (L2)
            .gauge-header-badge
              span.storage-fit-badge.badge-fit-normal -

          .gauge-bar-wrapper
            .gauge-bar-info
              .info-active
                span.info-label Active Indexes: 
                strong.storage-gauge-active-val -
                span.storage-gauge-unused-note.info-unused
              .info-buffers
                span.info-label shared_buffers: 
                strong.storage-gauge-buffers-val -
                span.storage-gauge-pct.info-pct
            .gauge-bar-track
              .gauge-bar-fill.storage-gauge-fill(style="width: 0%")
            .gauge-bar-scale
              span 0%
              span 50%
              span 100% (shared_buffers)
              span &gt;100% (OS Page Cache)

          .storage-metrics-chips
            .storage-chip
              span.chip-label Total DB Size
              strong.chip-val.storage-db-size-val -
            .storage-chip
              span.chip-label Active Indexes
              strong.chip-val.storage-active-index-size-val -
            .storage-chip.chip-unused-indexes(style="display: none;")
              span.chip-label Unused Indexes
              strong.chip-val.storage-unused-index-size-val -
            .storage-chip
              span.chip-label Total Indexes
              strong.chip-val.storage-index-size-val -
            .storage-chip
              span.chip-label shared_buffers (L1)
              strong.chip-val.storage-buffers-val -
            .storage-chip
              span.chip-label effective_cache_size (L2)
              strong.chip-val.storage-cache-val -
            .storage-chip
              span.chip-label work_mem
              strong.chip-val.storage-workmem-val -

        .section-subhead Top 10 Tables by Disk & Index Footprint
        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.top-tables-table
              thead
                tr
                  th Table Name
                  th(style="width: 90px;") Live Rows
                  th(style="width: 95px;") Table Data
                  th(style="width: 170px;") Indexes
                  th(style="width: 95px;") Indexes Size
                  th(style="width: 140px;") Index Scans
                  th(style="width: 95px;") Total Size
              tbody
                tr
                  td(colspan="7", class="text-muted text-center", style="padding: 14px;") No storage details loaded.

    // -------------------------------------------------------------
    // SECTION 3: VACUUM & BLOAT HEALTH
    // -------------------------------------------------------------
    .monitor-section(data-section="vacuum", class=expandedSections.vacuum ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Vacuum & Table Bloat Health
        span.section-summary-text= sectionSummaries.vacuum || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Vacuum Stats")
            +refreshIcon(11)

      .monitor-section-body
        .vacuum-progress-block(style="display: none;")

        .section-subhead Tables with Dead Tuples & Autovacuum Schedule
        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.table-bloat-table
              thead
                tr
                  th Table Name
                  th(style="width: 100px;") Live Rows
                  th(style="width: 100px;") Dead Rows
                  th(style="width: 85px;") Dead %
                  th(style="width: 120px;") Last Autovacuum
                  th(style="width: 90px;") Auto Count
                  th(style="width: 120px;") Status
              tbody
                tr
                  td(colspan="7", class="text-muted text-center", style="padding: 14px;") No vacuum statistics loaded.

    // -------------------------------------------------------------
    // SECTION 4: STREAMING REPLICATION & WAL
    // -------------------------------------------------------------
    .monitor-section(data-section="replication", class=expandedSections.replication ? 'expanded' : '', style=replicationData && replicationData.isConfigured ? '' : 'display: none;')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Streaming Replication & WAL Slots
        span.section-summary-text= sectionSummaries.replication || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Replication Stats")
            +refreshIcon(11)

      .monitor-section-body
        .section-subhead Standby Replicas & Sync Status
        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.replication-nodes-table
              thead
                tr
                  th Node / Application
                  th(style="width: 90px;") Mode
                  th(style="width: 100px;") State
                  th(style="width: 120px;") Lag (Bytes)
                  th Lag (Time)
              tbody
                tr
                  td(colspan="5", class="text-muted text-center", style="padding: 14px;") No replication details loaded.

        .section-subhead Replication Slots & Disk Retention
        .replication-slots-list
          span.text-muted Checking replication slots...

    // -------------------------------------------------------------
    // SECTION 5: SLOW QUERIES INSIGHTS
    // -------------------------------------------------------------
    .monitor-section(data-section="slow_queries", class=expandedSections.slow_queries ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Top Slow Queries (pg_stat_statements)
        span.section-summary-text= sectionSummaries.slow_queries || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Slow Queries")
            +refreshIcon(11)

      .monitor-section-body
        .slow-queries-not-installed(style="display: none;")
          .mac-callout-box
            strong Extension pg_stat_statements is not enabled.
            p This PostgreSQL extension tracks cumulative execution statistics across all queries.
            button.btn-native.btn-install-statements Enable Extension Now (CREATE EXTENSION)

        .slow-queries-installed
          .section-table-toolbar
            .toolbar-stats-text Showing top queries ranked by average execution time
            button.btn-native.btn-native-small.btn-refresh-slow-queries(title="Refresh Slow Queries")
              +refreshIcon(10)
              span Refresh Slow Queries
          .rescol-wrapper.with-borders
            .rescol-content-wrapper
              table.slow-queries-table
                thead
                  tr
                    th(style="width: 90px;") Avg Time
                    th(style="width: 90px;") Max Time
                    th(style="width: 80px;") Calls
                    th(style="width: 85px;") Rows
                    th(style="width: 130px;") Target Table
                    th Query
                    th(style="width: 90px;") Actions
                tbody
                  tr
                    td(colspan="7", class="text-muted text-center", style="padding: 16px;")
                      span No slow query data loaded yet. &nbsp;
                      button.btn-native.btn-native-small.btn-refresh-slow-queries Load Slow Queries

    // -------------------------------------------------------------
    // SECTION 6: INDEX OPTIMIZATION (UNUSED & DUPLICATE)
    // -------------------------------------------------------------
    .monitor-section(data-section="indexes", class=expandedSections.indexes ? 'expanded' : '')
      .monitor-section-header
        span.disclosure-triangle
        span.section-title Index Optimization (Unused & Duplicate)
        span.section-summary-text= sectionSummaries.indexes || ""
        .section-actions
          button.btn-section-icon.btn-section-refresh(title="Refresh Index Analysis")
            +refreshIcon(11)

      .monitor-section-body
        .section-table-toolbar
          .toolbar-stats-text Unused Indexes (idx_scan = 0 &bull; consuming storage and write I/O)
          button.btn-native.btn-native-small.btn-refresh-indexes(title="Refresh Index Analysis")
            +refreshIcon(10)
            span Refresh Indexes

        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.unused-indexes-table
              thead
                tr
                  th Table Name
                  th Index Name
                  th(style="width: 110px;") Index Size
                  th(style="width: 90px;") Scans
                  th(style="width: 140px;") Actions
              tbody
                tr
                  td(colspan="5", class="text-muted text-center", style="padding: 16px;") No unused indexes analyzed yet.

        .section-subhead(style="margin-top: 16px;") Duplicate & Redundant Indexes (Exact same columns & opclass)
        .rescol-wrapper.with-borders
          .rescol-content-wrapper
            table.duplicate-indexes-table
              thead
                tr
                  th Table Name
                  th Duplicate Index
                  th Redundant Of
                  th(style="width: 110px;") Index Size
                  th(style="width: 140px;") Actions
              tbody
                tr
                  td(colspan="5", class="text-muted text-center", style="padding: 16px;") No duplicate indexes analyzed yet.
